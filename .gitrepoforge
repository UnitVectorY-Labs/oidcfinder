name: oidcfinder
default_branch: main
config:
  description: "Deterministically discovers public OIDC and OAuth authorization-server metadata, validates JWKS, and maintains reviewable catalog candidates."
  license: MIT
  language: go
  release: release-go
  justfile: true
  codecov:
    enabled: false
  gitignore:
    - domains.db
    - data
    - .env
    - bin
    - /cloudflare-radar*.csv
    - "!/internal/oidcfinder/"
